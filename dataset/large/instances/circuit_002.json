{
  "id": "circuit_002",
  "name": "TWO_STAGE_AMP",
  "description": "Two-stage Miller OTA: diff pair + 1st-stage load + output stage",
  "grid": {
    "rows": 3,
    "cols": 4
  },
  "transistors": [
    {
      "id": "M1",
      "type": "nmos",
      "role": "diff_pair_nmos",
      "nets": {
        "gate": "INP",
        "drain": "OUT1",
        "source": "TAIL",
        "bulk": "GND"
      }
    },
    {
      "id": "M2",
      "type": "nmos",
      "role": "diff_pair_nmos",
      "nets": {
        "gate": "INN",
        "drain": "VBIAS",
        "source": "TAIL",
        "bulk": "GND"
      }
    },
    {
      "id": "M3",
      "type": "pmos",
      "role": "load_pmos",
      "nets": {
        "gate": "VBIAS",
        "drain": "VBIAS",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "M4",
      "type": "pmos",
      "role": "load_pmos",
      "nets": {
        "gate": "VBIAS",
        "drain": "OUT1",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "M5",
      "type": "nmos",
      "role": "tail_nmos",
      "nets": {
        "gate": "VB",
        "drain": "TAIL",
        "source": "GND",
        "bulk": "GND"
      }
    },
    {
      "id": "M6",
      "type": "pmos",
      "role": "output_pmos",
      "nets": {
        "gate": "OUT1",
        "drain": "OUT",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "M7",
      "type": "nmos",
      "role": "bias_nmos",
      "nets": {
        "gate": "VB",
        "drain": "OUT",
        "source": "GND",
        "bulk": "GND"
      }
    }
  ],
  "sizing_constraints": {
    "match_groups": [
      [
        "M1",
        "M2"
      ],
      [
        "M3",
        "M4"
      ]
    ],
    "bounds": {
      "M1": {
        "W_min": 1.26,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "M2": {
        "W_min": 1.26,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "M3": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "M4": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "M5": {
        "W_min": 2.1,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "M6": {
        "W_min": 2.1,
        "W_max": 4.2,
        "L_min": 0.15,
        "L_max": 0.35
      },
      "M7": {
        "W_min": 2.1,
        "W_max": 4.2,
        "L_min": 0.15,
        "L_max": 0.35
      }
    }
  }
}