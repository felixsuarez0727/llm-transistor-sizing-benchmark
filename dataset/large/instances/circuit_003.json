{
  "id": "circuit_003",
  "name": "FOLDED_CASCODE_OTA",
  "description": "Folded-cascode OTA: PMOS diff pair + NMOS cascode + bias",
  "grid": {
    "rows": 3,
    "cols": 4
  },
  "transistors": [
    {
      "id": "MP1",
      "type": "pmos",
      "role": "diff_pair_pmos",
      "nets": {
        "gate": "INP",
        "drain": "X1",
        "source": "TAIL",
        "bulk": "VDD"
      }
    },
    {
      "id": "MP2",
      "type": "pmos",
      "role": "diff_pair_pmos",
      "nets": {
        "gate": "INN",
        "drain": "X2",
        "source": "TAIL",
        "bulk": "VDD"
      }
    },
    {
      "id": "MTAIL",
      "type": "pmos",
      "role": "tail_pmos",
      "nets": {
        "gate": "VBP",
        "drain": "TAIL",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "MN1",
      "type": "nmos",
      "role": "bias_nmos",
      "nets": {
        "gate": "VBN2",
        "drain": "OUT",
        "source": "X1",
        "bulk": "GND"
      }
    },
    {
      "id": "MN2",
      "type": "nmos",
      "role": "bias_nmos",
      "nets": {
        "gate": "VBN2",
        "drain": "X3",
        "source": "X2",
        "bulk": "GND"
      }
    },
    {
      "id": "MN3",
      "type": "nmos",
      "role": "mirror_nmos",
      "nets": {
        "gate": "VBN1",
        "drain": "X1",
        "source": "GND",
        "bulk": "GND"
      }
    },
    {
      "id": "MN4",
      "type": "nmos",
      "role": "mirror_nmos",
      "nets": {
        "gate": "VBN1",
        "drain": "X3",
        "source": "GND",
        "bulk": "GND"
      }
    }
  ],
  "sizing_constraints": {
    "match_groups": [
      [
        "MP1",
        "MP2"
      ],
      [
        "MN1",
        "MN2"
      ],
      [
        "MN3",
        "MN4"
      ]
    ],
    "bounds": {
      "MP1": {
        "W_min": 1.26,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MP2": {
        "W_min": 1.26,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MTAIL": {
        "W_min": 2.1,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MN1": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MN2": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MN3": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MN4": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      }
    }
  }
}