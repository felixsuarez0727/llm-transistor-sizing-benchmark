{
  "id": "circuit_011",
  "name": "SUPER_MIRROR",
  "description": "High-swing regulated cascode mirror (super mirror): 5 NMOS",
  "grid": {
    "rows": 3,
    "cols": 4
  },
  "transistors": [
    {
      "id": "M1",
      "type": "nmos",
      "role": "mirror_nmos",
      "nets": {
        "gate": "VG1",
        "drain": "VG1",
        "source": "GND",
        "bulk": "GND"
      }
    },
    {
      "id": "M2",
      "type": "nmos",
      "role": "bias_nmos",
      "nets": {
        "gate": "VG2",
        "drain": "VG1",
        "source": "X1",
        "bulk": "GND"
      }
    },
    {
      "id": "M3",
      "type": "nmos",
      "role": "mirror_nmos",
      "nets": {
        "gate": "VG1",
        "drain": "X2",
        "source": "GND",
        "bulk": "GND"
      }
    },
    {
      "id": "M4",
      "type": "nmos",
      "role": "bias_nmos",
      "nets": {
        "gate": "VG2",
        "drain": "OUT",
        "source": "X2",
        "bulk": "GND"
      }
    },
    {
      "id": "M5",
      "type": "nmos",
      "role": "bias_nmos",
      "nets": {
        "gate": "X1",
        "drain": "VG2",
        "source": "X1",
        "bulk": "GND"
      }
    },
    {
      "id": "MPLD",
      "type": "pmos",
      "role": "load_pmos",
      "nets": {
        "gate": "VBP",
        "drain": "VG1",
        "source": "VDD",
        "bulk": "VDD"
      }
    }
  ],
  "sizing_constraints": {
    "match_groups": [
      [
        "M1",
        "M3"
      ],
      [
        "M2",
        "M4"
      ]
    ],
    "bounds": {
      "M1": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "M2": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "M3": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "M4": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "M5": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MPLD": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.18,
        "L_max": 0.5
      }
    }
  }
}