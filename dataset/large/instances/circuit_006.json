{
  "id": "circuit_006",
  "name": "RECYCLING_FC",
  "description": "Recycling folded-cascode OTA: reuses diff-pair current for gain",
  "grid": {
    "rows": 3,
    "cols": 4
  },
  "transistors": [
    {
      "id": "M1",
      "type": "nmos",
      "role": "diff_pair_nmos",
      "nets": {
        "gate": "INP",
        "drain": "X1",
        "source": "TAIL",
        "bulk": "GND"
      }
    },
    {
      "id": "M2",
      "type": "nmos",
      "role": "diff_pair_nmos",
      "nets": {
        "gate": "INN",
        "drain": "X2",
        "source": "TAIL",
        "bulk": "GND"
      }
    },
    {
      "id": "MB",
      "type": "nmos",
      "role": "tail_nmos",
      "nets": {
        "gate": "VBN",
        "drain": "TAIL",
        "source": "GND",
        "bulk": "GND"
      }
    },
    {
      "id": "MP1",
      "type": "pmos",
      "role": "load_pmos",
      "nets": {
        "gate": "X1",
        "drain": "X1",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "MP2",
      "type": "pmos",
      "role": "load_pmos",
      "nets": {
        "gate": "X1",
        "drain": "OUT",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "MNC",
      "type": "nmos",
      "role": "bias_nmos",
      "nets": {
        "gate": "VBN2",
        "drain": "OUT",
        "source": "X2",
        "bulk": "GND"
      }
    },
    {
      "id": "MNB",
      "type": "nmos",
      "role": "mirror_nmos",
      "nets": {
        "gate": "VBN1",
        "drain": "X2",
        "source": "GND",
        "bulk": "GND"
      }
    }
  ],
  "sizing_constraints": {
    "match_groups": [
      [
        "M1",
        "M2"
      ],
      [
        "MP1",
        "MP2"
      ]
    ],
    "bounds": {
      "M1": {
        "W_min": 1.26,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "M2": {
        "W_min": 1.26,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MB": {
        "W_min": 2.1,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MP1": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MP2": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MNC": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MNB": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.35,
        "L_max": 1.0
      }
    }
  }
}