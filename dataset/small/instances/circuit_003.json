{
  "id": "circuit_003",
  "name": "MIRROR_N",
  "description": "NMOS current mirror: diode-connected reference + output",
  "grid": {
    "rows": 2,
    "cols": 3
  },
  "transistors": [
    {
      "id": "MREF",
      "type": "nmos",
      "role": "mirror_nmos",
      "nets": {
        "gate": "BIAS",
        "drain": "BIAS",
        "source": "GND",
        "bulk": "GND"
      }
    },
    {
      "id": "MOUT",
      "type": "nmos",
      "role": "mirror_nmos",
      "nets": {
        "gate": "BIAS",
        "drain": "OUT",
        "source": "GND",
        "bulk": "GND"
      }
    }
  ],
  "sizing_constraints": {
    "match_groups": [
      [
        "MREF",
        "MOUT"
      ]
    ],
    "bounds": {
      "MREF": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      },
      "MOUT": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.35,
        "L_max": 1.0
      }
    }
  }
}