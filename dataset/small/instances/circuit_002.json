{
  "id": "circuit_002",
  "name": "NAND2",
  "description": "2-input NAND: 2 parallel PMOS + 2 series NMOS",
  "grid": {
    "rows": 2,
    "cols": 3
  },
  "transistors": [
    {
      "id": "MP1",
      "type": "pmos",
      "role": "logic_pmos",
      "nets": {
        "gate": "A",
        "drain": "OUT",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "MP2",
      "type": "pmos",
      "role": "logic_pmos",
      "nets": {
        "gate": "B",
        "drain": "OUT",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "MN1",
      "type": "nmos",
      "role": "logic_nmos",
      "nets": {
        "gate": "A",
        "drain": "OUT",
        "source": "X",
        "bulk": "GND"
      }
    },
    {
      "id": "MN2",
      "type": "nmos",
      "role": "logic_nmos",
      "nets": {
        "gate": "B",
        "drain": "X",
        "source": "GND",
        "bulk": "GND"
      }
    }
  ],
  "sizing_constraints": {
    "match_groups": [
      [
        "MP1",
        "MP2"
      ]
    ],
    "bounds": {
      "MP1": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.15,
        "L_max": 0.35
      },
      "MP2": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.15,
        "L_max": 0.35
      },
      "MN1": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.15,
        "L_max": 0.35
      },
      "MN2": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.15,
        "L_max": 0.35
      }
    }
  }
}