{
  "id": "circuit_017",
  "name": "SR_LATCH",
  "description": "SR latch: 2 cross-coupled NAND pairs (4 NMOS + 2 PMOS)",
  "grid": {
    "rows": 2,
    "cols": 3
  },
  "transistors": [
    {
      "id": "MP1",
      "type": "pmos",
      "role": "logic_pmos",
      "nets": {
        "gate": "S",
        "drain": "Q",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "MN1",
      "type": "nmos",
      "role": "logic_nmos",
      "nets": {
        "gate": "S",
        "drain": "Q",
        "source": "X1",
        "bulk": "GND"
      }
    },
    {
      "id": "MN2",
      "type": "nmos",
      "role": "logic_nmos",
      "nets": {
        "gate": "QB",
        "drain": "X1",
        "source": "GND",
        "bulk": "GND"
      }
    },
    {
      "id": "MP2",
      "type": "pmos",
      "role": "logic_pmos",
      "nets": {
        "gate": "R",
        "drain": "QB",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "MN3",
      "type": "nmos",
      "role": "logic_nmos",
      "nets": {
        "gate": "R",
        "drain": "QB",
        "source": "X2",
        "bulk": "GND"
      }
    },
    {
      "id": "MN4",
      "type": "nmos",
      "role": "logic_nmos",
      "nets": {
        "gate": "Q",
        "drain": "X2",
        "source": "GND",
        "bulk": "GND"
      }
    }
  ],
  "sizing_constraints": {
    "match_groups": [
