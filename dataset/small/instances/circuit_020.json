{
  "id": "circuit_020",
  "name": "CLOCKED_INV",
  "description": "Clocked inverter: INV gated by CK/CKB PMOS+NMOS",
  "grid": {
    "rows": 2,
    "cols": 3
  },
  "transistors": [
    {
      "id": "MP1",
      "type": "pmos",
      "role": "inv_pmos",
      "nets": {
        "gate": "IN",
        "drain": "MID",
        "source": "PSW",
        "bulk": "VDD"
      }
    },
    {
      "id": "MPSW",
      "type": "pmos",
      "role": "logic_pmos",
      "nets": {
        "gate": "CKB",
        "drain": "PSW",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "MN1",
      "type": "nmos",
      "role": "inv_nmos",
      "nets": {
        "gate": "IN",
        "drain": "MID",
        "source": "NSW",
        "bulk": "GND"
      }
    },
    {
      "id": "MNSW",
      "type": "nmos",
      "role": "logic_nmos",
      "nets": {
        "gate": "CK",
        "drain": "NSW",
        "source": "GND",
        "bulk": "GND"
      }
    }
  ],
  "sizing_constraints": {
    "match_groups": [
      [
        "MP1",
        "MN1"
      ]
    ],
    "bounds": {
      "MP1": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.15,
        "L_max": 0.35
      },
      "MPSW": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.15,
        "L_max": 0.35
      },
      "MN1": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.15,
        "L_max": 0.35
      },
      "MNSW": {
        "W_min": 0.84,
        "W_max": 2.1,
        "L_min": 0.15,
        "L_max": 0.35
      }
    }
  }
}