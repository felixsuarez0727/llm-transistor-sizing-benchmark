        "L_max": 0.35
      },
      "MNP": {
        "W_min": 0.42,
        "W_max": 1.26,
        "L_min": 0.15,
        "L_max": 0.35
      },
      "MNN": {
        "W_min": 0.42,
        "W_max": 1.26,
        "L_min": 0.15,
        "L_max": 0.35
      }
    }
  }
