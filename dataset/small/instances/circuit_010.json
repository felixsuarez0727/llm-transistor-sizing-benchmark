{
  "id": "circuit_010",
  "name": "TRISTATE",
  "description": "Tri-state buffer: PMOS + NMOS pass + enable devices",
  "grid": {
    "rows": 2,
    "cols": 3
  },
  "transistors": [
    {
      "id": "MP",
      "type": "pmos",
      "role": "inv_pmos",
      "nets": {
        "gate": "IN",
        "drain": "OUT",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "MNP",
      "type": "nmos",
      "role": "logic_nmos",
      "nets": {
        "gate": "EN",
        "drain": "OUT",
        "source": "MID",
        "bulk": "GND"
      }
    },
    {
      "id": "MNN",
      "type": "nmos",
      "role": "inv_nmos",
      "nets": {
        "gate": "IN",
        "drain": "MID",
        "source": "GND",
        "bulk": "GND"
      }
    }
  ],
  "sizing_constraints": {
    "match_groups": [],
