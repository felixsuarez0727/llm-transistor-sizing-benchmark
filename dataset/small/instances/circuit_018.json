{
  "id": "circuit_018",
  "name": "BUFF",
  "description": "CMOS buffer: two cascaded inverters (4 transistors)",
  "grid": {
    "rows": 2,
    "cols": 3
  },
  "transistors": [
    {
      "id": "MP1",
      "type": "pmos",
      "role": "inv_pmos",
      "nets": {
        "gate": "IN",
        "drain": "MID",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "MN1",
      "type": "nmos",
      "role": "inv_nmos",
      "nets": {
        "gate": "IN",
        "drain": "MID",
        "source": "GND",
        "bulk": "GND"
      }
    },
    {
      "id": "MP2",
      "type": "pmos",
      "role": "inv_pmos",
      "nets": {
        "gate": "MID",
        "drain": "OUT",
        "source": "VDD",
        "bulk": "VDD"
      }
    },
    {
      "id": "MN2",
      "type": "nmos",
      "role": "inv_nmos",
      "nets": {
        "gate": "MID",
        "drain": "OUT",
        "source": "GND",
        "bulk": "GND"
      }
    }
  ],
  "sizing_constraints": {
    "match_groups": [
      [
        "MP1",
        "MP2"
      ],
      [
        "MN1",
        "MN2"
      ]
    ],
    "bounds": {
      "MP1": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.15,
        "L_max": 0.35
      },
      "MN1": {
        "W_min": 0.42,
        "W_max": 2.1,
        "L_min": 0.15,
        "L_max": 0.35
      },
      "MP2": {
        "W_min": 0.84,
        "W_max": 4.2,
        "L_min": 0.15,
        "L_max": 0.35
      },
      "MN2": {
        "W_min": 0.42,
        "W_max": 2.1,
        "L_min": 0.15,
        "L_max": 0.35
      }
    }
  }
}